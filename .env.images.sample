# CPM blog hero-image stage (Track C) — gen-hero.mjs config.
# Copy this file to .env.images and fill in your key. .env.images is gitignored.
#
# Get a key at https://aistudio.google.com/apikey
# The default model (gemini-2.5-flash-image, "Nano Banana") has a free tier.
# To switch engines later, just change GEMINI_IMAGE_MODEL — no code change:
#   gemini-2.5-flash-image          (default; free tier; 16:9 supported)
#   imagen-4.0-fast-generate-001    (Imagen 4 Fast; paid tier; cleanest framing)
#   gemini-3-pro-image-preview      (Nano Banana Pro; highest quality; higher cost)

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
