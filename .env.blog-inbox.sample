# CPM blog inbox — IMAP credentials for the email-bridge harvester (Track D).
# Copy this file to ".env.blog-inbox" (same dir) and fill in real values.
# The real .env.blog-inbox is gitignored (.env*) and MUST NEVER be committed —
# the repo is public.

# Mailbox the iPhone emails contracts to.
CPM_IMAP_HOST=imap.gmail.com
CPM_IMAP_PORT=993
CPM_IMAP_USER=cpmblog93012@gmail.com

# Gmail APP PASSWORD (16 chars, NO spaces) — NOT the account login password.
# Generate at: myaccount.google.com/apppasswords (requires 2-Step Verification).
CPM_IMAP_PASS=xxxxxxxxxxxxxxxx

# Optional: which mailbox/folder to read (default INBOX).
CPM_IMAP_MAILBOX=INBOX

# Anti-injection allowlist (REQUIRED): comma-separated sender addresses the
# runner will accept. Mail from anyone else is ignored. Set this to whatever
# address your iPhone Mail sends from.
CPM_ALLOWED_SENDERS=cpm@c-p-m.com
