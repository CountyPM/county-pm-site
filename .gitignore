# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the credential-less sample IS committed as documentation
!.env.blog-inbox.sample

# blog pipeline private sidecar (gemini prompts, source chat context) — never commit
.blog-sidecar/

# blog capture/handoff (track D) — inbox + archive hold raw contracts with
# private fields (source_chat_context, gemini_prompt). NEVER commit these.
/incoming/
/.blog-processed/
cpm-blog_*.md
# IMAP credentials for the inbox harvester live in .env.blog-inbox (covered by .env* above)
blog-*.log
scripts/_*

# FAQ pipeline (track A): derived corpus index + unreviewed AI drafts — never commit
scripts/faq-corpus-index.json
content/faq-drafts/
content/faq-backfill/
content/faq-reconcile/
content/faq-crosslink/
.faq-backfill/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
