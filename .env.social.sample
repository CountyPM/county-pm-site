# CPM Social Auto-Post credentials — copy to .env.social and fill in.
# .env.social is gitignored. See docs/CPM_Social_AutoPost_Setup.md for how to obtain each value.

# ---- LinkedIn (personal profile posting) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# 60-day access token from the LinkedIn Token Generator (scope: w_member_social, openid, profile).
LINKEDIN_ACCESS_TOKEN=
# Filled by `npm run social:whoami`. Looks like urn:li:person:AbC123
LINKEDIN_PERSON_URN=
# LinkedIn API version pin (YYYYMM). Bump occasionally; LinkedIn keeps ~12 months of versions.
LINKEDIN_API_VERSION=202605

# ---- Google Business Profile (local posts) ----
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# One-time refresh token from `npm run social:google-auth` (auto-renews thereafter).
GBP_REFRESH_TOKEN=
# From `npm run social:gbp-locations`. Full resource names.
GBP_ACCOUNT_ID=accounts/XXXXXXXXXXXX
GBP_LOCATION_ID=locations/XXXXXXXXXXXX

# ---- Poster behavior ----
SOCIAL_TARGETS=linkedin,gbp
SOCIAL_QUEUE_DIR=content/social-queue
LINKEDIN_TOKEN_WARN_DAYS=7
# SOCIAL_HEARTBEAT_TO=cpm@c-p-m.com
